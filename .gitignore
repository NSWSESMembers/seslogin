.env.secret
CLAUDE.local.md

# Terraform — .terraform.lock.hcl is committed: it pins the provider version so
# everyone runs `terraform init` against the same one. Only the working
# state/cache and secret values are ignored.
infra/terraform.tfvars
infra/.terraform/
local/mail/
local/.dynamodb-data/
local/.dynamodb.pid
local/.dynamodb.log
local/dynamodb-local/
local/.e2e/
# Toolchain the session-start hook downloads (actionlint, terraform) so `make check`
# can run in a fresh cloud container.
/.claude/tools/

# Only web/ has a package.json, but the Playwright examples in local/examples are
# run with a playwright installed wherever Node can resolve it -- often here.
/node_modules/
