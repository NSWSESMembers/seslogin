DB_PREFIX=seslogin_test
SES_PAGE_LIMIT=100
SES_SYNC_MAX_RETRIES=3
SES_SYNC_MAX_MUTATIONS=100

# Make the dev API server work for local development
# see also VITE_TURNSTILE_DISABLED in web/.env.local
TURNSTILE_DISABLED=1
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Redirect ALL outgoing email to one address. Uncomment (with your own address)
# before testing anything that emails a member — the seslogin_test snapshot holds
# real member email addresses, so the admin "Remind" button would otherwise mail a
# real volunteer from your laptop. Never set this in a deployed environment.
# MAIL_OVERRIDE_TO=you@example.com
