# Environment for the AWS-free local stack (`make dev-local`).
#
# `make dev-local` exports these before starting the API, and exported variables
# win over `.env`: dotenvy's `from_filename` never overrides a variable that is
# already set. So this file, not `.env`, decides where local runs point.
#
# Everything here is fake. There are no real credentials in this file and there
# must never be any — it is checked in.

# A database of its own, so nothing here can be confused with the seslogin_test
# snapshot (which holds real member data) let alone seslogin_prod.
DB_PREFIX=seslogin_local

# Send DynamoDB traffic to the local DynamoDB started by local/dynamodb.sh. The
# AWS SDK reads this natively, so no code knows the difference. If you move it
# with LOCAL_DDB_PORT, change this too.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8100

# Dummy static credentials. DynamoDB Local ignores them, but they must exist or
# the SDK falls back to the `seslogin` SSO profile and tries to reach real AWS.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-2

# Note there is no variable selecting the mocks: `make dev-local` runs the
# `poem-local` binary, which is compiled with them. `poem` has no code path that
# can reach a mock, and needs the three *_QUEUE_URL variables from .env.secret.

# Uncomment to also drop each "sent" email into a file — easier than reading an
# HTML email out of a log line. Relative paths resolve from api/, since that's
# where the server runs; this one lands in local/mail at the repo root.
# MOCK_MAIL_DIR=../local/mail

# Not a secret: this signs tokens that are only ever valid against your own
# machine's local database.
JWT_SECRET=local-dev-not-a-secret

# Turnstile can't work against localhost; pair with VITE_TURNSTILE_DISABLED=1 in
# web/.env.local.
TURNSTILE_DISABLED=1
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173
